# Template only. Keep every secret value empty; this file is never a production secret store.
# Gateway process variables are deployed through the approved service environment mechanism.
HERMES_BRIDGE_TOKEN=
HERMES_BRIDGE_ALLOWED_HOSTS=
HERMES_BRIDGE_ALLOWED_ORIGINS=
HERMES_BRIDGE_TAILSCALE_SERVE_HOST=
HERMES_BRIDGE_TAILSCALE_APP_CAPABILITY=hermes.local/windows-control

# Lifecycle scripts create the token under a restrictive ACL. This hint contains no secret.
HERMES_BRIDGE_TOKEN_FILE=%ProgramData%\HermesWindowsBridge\secrets\token

# Oracle Hermes uses its own secret environment variable for the outgoing Authorization header.
HERMES_WINDOWS_BRIDGE_TOKEN=
